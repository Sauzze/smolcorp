;; A desk's sandbox (Smolcorp, SANDBOX-PLAN Appendix A), made from its Policy at its start.
(version 1)
(allow default)

;; Denied by default: unix sockets, Mach services, IOKit, signals
(deny network-outbound (remote unix-socket)) ; unix sockets: only those allowed below
(deny mach-lookup) ; Mach services: only those on its list
(deny iokit-open) ; IOKit: only the classes on its list
(deny signal) ; signals: only to its own sandbox (C1)

;; What it may still reach
(allow network-outbound (literal "/private/tmp/smolcorp-501/h1/s")) ; its own socket
(allow network-outbound (literal "/private/var/run/mDNSResponder")) ; a socket on its list
(allow network-outbound (literal "/private/var/run/syslog")) ; a socket on its list
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo")) ; a Mach service on its list
(allow mach-lookup (global-name "com.apple.trustd.agent")) ; a Mach service on its list
(allow iokit-open (iokit-registry-entry-class "IOSurfaceRootUserClient")) ; an IOKit class on its list
(allow iokit-open (iokit-user-client-class "IOSurfaceSendRight")) ; an IOKit class on its list
(allow signal (target same-sandbox)) ; its own processes (C1)

;; Allowed places
(allow file-read-data file-read-xattr (subpath "/Users/ada/.claude")) ; the account folders
(allow file-read-data file-read-xattr (subpath "/Users/ada/.claude-work")) ; the account folders
(allow file-read-data file-read-xattr file-write* file-link (subpath "/Users/ada/Projects/app")) ; its own place
(allow file-write* file-link (subpath "/Users/ada/Projects/app/.git")) ; the rest of the shared .git

;; Denied places an exception opens
(deny file-read-data file-read-xattr file-write* file-link (regex "^/Users/ada/\\.ssh/[^/]*(/.*)?$")) ; ssh keys while Remote Login answers
(deny file-write* file-link (subpath "/Users/ada/Projects/app-hires")) ; other desks' places
(deny file-write* file-link (subpath "/private/tmp/smolcorp-501")) ; the socket folder
(deny file-read-data file-read-xattr file-write* file-link network-outbound (subpath "/Users/ada/Library/Application Support/AgentDeck")) ; the support folder, whole

;; The exceptions
(allow file-read-data file-read-xattr file-write* file-link (regex "^/Users/ada/\\.ssh/[^/]*\\.pub$")) ; ssh files that aren't keys
(allow file-read-data file-read-xattr file-write* file-link (regex "^/Users/ada/\\.ssh/known_hosts[^/]*$")) ; ssh files that aren't keys
(allow file-read-data file-read-xattr file-write* file-link (regex "^/Users/ada/\\.ssh/config$")) ; ssh files that aren't keys
(allow file-read-data file-read-xattr file-write* file-link (subpath "/private/tmp/smolcorp-501/h1")) ; its own socket folder
(allow file-read-data file-read-xattr (literal "/Users/ada/Library/Application Support/AgentDeck/hire-guard.json")) ; the guard file: the guard reads it
(allow file-read-data file-read-xattr (literal "/Users/ada/Library/Application Support/AgentDeck/nightshift.json")) ; the night shift's jobs: read only, as the guard file
(allow file-read-data file-read-xattr file-write* file-link (regex "^/Users/ada/Library/Application Support/AgentDeck/hires/h1/[^/]*\\.md$")) ; its status and report
(allow file-read-data file-read-xattr (regex "^/Users/ada/Library/Application Support/AgentDeck/hires/h1/BRIEF[^/]*\\.md$")) ; its brief and its fence
(allow file-read-data file-read-xattr (regex "^/Users/ada/Library/Application Support/AgentDeck/hires/h1/settings\\.json$")) ; its brief and its fence
(allow file-read-data file-read-xattr (regex "^/Users/ada/Library/Application Support/AgentDeck/hires/h1/sandbox\\.sb$")) ; its brief and its fence
(allow file-read-data file-read-xattr file-write* file-link (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude")) ; its own Claude folder
(allow file-read-data file-read-xattr (regex "^/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/settings[^/]*\\.json$")) ; its own Claude folder's fence
(allow file-read-data file-read-xattr (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/CLAUDE.md")) ; the links the core put in its Claude folder
(allow file-read-data file-read-xattr (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/commands")) ; the links the core put in its Claude folder
(allow file-read-data file-read-xattr (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/agents")) ; the links the core put in its Claude folder
(allow file-read-data file-read-xattr (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/skills")) ; the links the core put in its Claude folder
(allow file-read-data file-read-xattr (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/plugins")) ; the links the core put in its Claude folder
(allow file-read-data file-read-xattr (subpath "/Users/ada/Library/Application Support/AgentDeck/hires/h1/claude/output-styles")) ; the links the core put in its Claude folder
(allow network-outbound (literal "/Users/ada/Library/Application Support/AgentDeck/desk-start")) ; the desk-start socket

