;; Denied, whatever allows it
(deny network-outbound (remote tcp4 "localhost:22")) ; a local port on its list: any address of this Mac
(deny network-outbound (remote tcp6 "*:22")) ; a local port on its list: any IPv6 address, ::ffff:127.0.0.1 too (C4)
(deny network-outbound (remote tcp4 "localhost:2375")) ; a local port on its list: any address of this Mac
(deny network-outbound (remote tcp6 "*:2375")) ; a local port on its list: any IPv6 address, ::ffff:127.0.0.1 too (C4)
(deny network-outbound (remote tcp4 "localhost:2376")) ; a local port on its list: any address of this Mac
(deny network-outbound (remote tcp6 "*:2376")) ; a local port on its list: any IPv6 address, ::ffff:127.0.0.1 too (C4)
(deny network-outbound (remote tcp4 "localhost:5432")) ; a local port on its list: any address of this Mac
(deny network-outbound (remote tcp6 "*:5432")) ; a local port on its list: any IPv6 address, ::ffff:127.0.0.1 too (C4)
(deny network-outbound (remote tcp4 "localhost:3306")) ; a local port on its list: any address of this Mac
(deny network-outbound (remote tcp6 "*:3306")) ; a local port on its list: any IPv6 address, ::ffff:127.0.0.1 too (C4)
(deny network-outbound (literal "/private/tmp/com.apple.launchd.standin/Listeners")) ; an agent, while Remote Login answers (C5)
(deny network-outbound (literal "/Users/ada/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock")) ; an agent, while Remote Login answers (C5)
(deny file-ioctl (ioctl-command (_IO "t" 114))) ; typing into a terminal (TIOCSTI)
(deny file-issue-extension generic-issue-extension iokit-issue-extension mach-issue-extension (extension-class "com.apple.sandbox.pty")) ; a terminal's key, made by the desk itself
(deny appleevent-send) ; Apple Events
(deny lsopen) ; opening apps (LaunchServices)
(deny job-creation) ; new launchd jobs
(deny file-mount file-unmount) ; mounting or unmounting a file system
(deny file-read-data file-read-xattr file-write* file-link (regex "^/dev/bpf[0-9]*$")) ; capturing packets (/dev/bpf)
(deny file-issue-extension generic-issue-extension mach-issue-extension iokit-issue-extension) ; handing its rights to another process (sandbox extensions, of every kind): its mark stays its sandbox's alone
