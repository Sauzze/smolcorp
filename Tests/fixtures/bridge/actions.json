{
  "about": "The host bridge's actions for what only macOS does (M2m): each request as the Go core sends it (desktop/hostbridge.go, without its token) and the Mac app's answer (Sources/AgentDeck/HostBridge.swift), on the stand-ins both tests use. desktop/hostbridge_test.go checks the core asks exactly this and reads the answer; HostBridgeTests.swift checks the app answers exactly this.",
  "cases": [
    {
      "name": "setup's facts, the apps keys may go to left out of those running",
      "request": {"action": "facts", "apps": ["com.example.notes"]},
      "answer": {"ok": true, "facts": {
        "accessibility": false,
        "testCopy": true,
        "dictation": {"available": true, "allowed": false, "languages": ["fr_FR", "en_US"], "suggested": "en_US",
                      "glossary": ["Smolcorp", "Claude"], "cleanupProblem": null},
        "running": [{"id": "com.example.mail", "name": "Mail"}],
        "terminalCommand": {"available": true, "state": "absent", "link": "~/.local/bin/smolcorp", "onPath": false,
                            "pathLine": "export PATH=\"$HOME/.local/bin:$PATH\"", "pathFile": "~/.zshrc", "testCopy": true}
      }}
    },
    {"name": "In the Dock, switched off", "request": {"action": "dock", "on": false}, "answer": {"ok": true}},
    {"name": "Accessibility asked for", "request": {"action": "accessibility"}, "answer": {"ok": true}},
    {"name": "keys in other apps switched on", "request": {"action": "keystrokes-on"}, "answer": {"ok": true}},
    {
      "name": "an app allowed keys",
      "request": {"action": "keystroke-apps", "apps": ["com.example.notes"], "app": "com.example.mail", "on": true},
      "answer": {"ok": true, "apps": ["com.example.notes", "com.example.mail"]}
    },
    {
      "name": "an app taken off, any capitals",
      "request": {"action": "keystroke-apps", "apps": ["com.example.notes", "com.example.mail"], "app": "COM.EXAMPLE.NOTES", "on": false},
      "answer": {"ok": true, "apps": ["com.example.mail"]}
    },
    {
      "name": "a terminal never allowed keys",
      "request": {"action": "keystroke-apps", "apps": ["com.example.notes"], "app": "com.apple.Terminal", "on": true},
      "answer": {"ok": false, "error": "Keys are never sent to a terminal, an editor with a terminal, Claude, a password or settings app, or Smolcorp itself."}
    },
    {
      "name": "dictation's names, checked",
      "request": {"action": "glossary", "names": ["Smolcorp", " smolcorp ", "Tailscale", ""]},
      "answer": {"ok": true, "names": ["Smolcorp", "Tailscale"]}
    },
    {
      "name": "dictation got ready, with a problem",
      "request": {"action": "dictation", "language": "fr_FR"},
      "answer": {"ok": true, "problem": "Apple's model for French couldn't be downloaded."}
    },
    {
      "name": "dictation in a language it doesn't know",
      "request": {"action": "dictation", "language": "xx_XX"},
      "answer": {"ok": false, "error": "Not a language dictation knows."}
    },
    {
      "name": "Add smolcorp to Terminal, in a test copy",
      "request": {"action": "terminal-command", "on": true},
      "answer": {"ok": false, "error": "This is a test copy of Smolcorp: it leaves your Terminal's commands to the copy in use."}
    },
    {
      "name": "the desks' terminals, from the drivers' tables",
      "request": {"action": "abilities", "tabs": ["iterm:AB12", "tty:/dev/ttys003", "headless:3f2a9c1e"]},
      "answer": {"ok": true, "abilities": [
        {"keys": true, "text": true, "fire": true, "screen": true},
        {"keys": true, "text": true, "fire": true, "screen": true},
        {"keys": false, "text": false, "fire": false, "screen": false}
      ]}
    },
    {
      "name": "Grok Bots looked for in the Grok Bot app",
      "request": {"action": "bots-resolve", "bots": [{"botId": "", "bot": "Smolcorp Mini"}, {"botId": "", "bot": "Nobody Here"}]},
      "answer": {"ok": true, "resolved": [{"botId": "0a1b-2c3d", "name": "Smolcorp Mini Manager", "by": "guess"}, null]}
    }
  ]
}
