<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime lets Smolcorp do, for a Developer ID release
  (scripts/release.sh with SMOLCORP_DEVELOPER_ID set; an ad hoc build doesn't
  use this): send Apple Events to Terminal, Spotify and Music, and hear the mic
  for dictation. macOS still asks the person first, as the Info.plist says.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
